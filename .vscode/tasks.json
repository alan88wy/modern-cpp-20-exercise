{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "C:/Windows/System32/cmd.exe",
                "args": ["/d", "/c"]
            }
        }
    },
    "tasks": [
        {
            "label": "Build with GCC16 Modules",
            "type": "shell",
            "command": "C:/Users/alan/scoop/apps/mingw/current/bin/g++.exe",
            "args": [
                "-std=c++23",
                "-fmodules-ts",
                "${file}",
                "-lstdc++exp",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": { "cwd": "${fileDirname}" },
            "group": { "kind": "build", "isDefault": false },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build std module",
            "type": "shell",
            "command": "cmd.exe",
            "args": ["/c", "call", "${workspaceFolder}/build-std.bat"],
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build application with MSVC",
            "type": "shell",
            "dependsOn": "Build std module",
            "command": "cmd.exe",
            "args": [
                "/c",
                "call",
                "${workspaceFolder}/build-app.bat",
                "${file}"
            ],
            "problemMatcher": ["$msCompile"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
