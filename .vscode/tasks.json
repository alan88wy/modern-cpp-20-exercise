{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "C:\\Windows\\System32\\cmd.exe",
                "args": [
                    "/d",
                    "/c"
                ]
            }
        }
    },
    "tasks": [
        {
            "label": "Build with GCC16 Modules",
            "type": "shell",
            "command": "C:/Users/alan/scoop/apps/msys2/current/mingw64/bin/g++.exe",
            "args": [
                "-std=c++23",
                "-fmodules-ts",
                "${file}",
                "-lstdc++exp",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\Users\\alan\\scoop\\apps\\msys2\\current\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },
        {
            "label": "C/C++: cl.exeBuild std module",
            "type": "shell",
            "command": "call",
            "args": [
                "${workspaceFolder}\\build-std.bat"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "C/C++: cl.exe Build All modules",
            "type": "shell",
            "command": "call",
            "args": [
                "${workspaceFolder}\\build-all-modules.bat"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "C/C++: cl.exe Build current file with MSVC",
            "type": "shell",
            "command": "call",
            "args": [
                "${workspaceFolder}\\build-app.bat",
                "${file}"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:/Users/alan/scoop/apps/msys2/current/mingw64/bin/gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "C:/Users/alan/scoop/apps/msys2/current/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}